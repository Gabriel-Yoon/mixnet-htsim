! ==========================================================================
! thermal_tile_transient.inp -- SINGLE TILE of the glass panel stack, transient.
!
! WHY A SINGLE TILE. The published <=9 K / 0.72 nm drift numbers came from
! thermal_pic/, which is the ICCAD OIO3D GPU/EIC/aPIC single stack -- a DIFFERENT
! stack from this panel (different layers, different materials, 45 C coolant).
! Any drift number in this paper has to come from THIS stack. A transient on the
! full 4x4 at NDPT=32 is far heavier than the ~5 min steady solves; one tile with
! the identical layer stack, materials and BCs answers the question at a fraction
! of the cost, and the steady result already shows tiles are thermally near-
! independent (the panel gradient is set by the coolant, not by tile coupling).
!
! Represents the OUTLET tile: the coolant there is TCP_IN + TCP_RISE, so this runs
! at a uniform 60 C plate temperature rather than a gradient across one tile,
! which would be a 20 C rise over 30 mm and unphysical.
!
! Load: PIC held at the 1600-provisioned corner power (43 W) throughout, GPU
! stepped idle -> 700 W. The PIC is not switched because its power is set by the
! link budget, not by the compute phase.
!
! Params (wrapper *SET): MATFLAG, HCP, TCP, P_GPU, FHOT, P_PIC, NDPT, TEND.
! ==========================================================================
/PREP7
TILE_W=28.3e-3
T_BRD=0.5e-3 $ T_SUB=0.7e-3 $ T_PIC=0.05e-3 $ T_RDL=0.1e-3 $ T_DIE=0.75e-3

*IF,MATFLAG,EQ,1,THEN
  KMAT=1.2
*ELSE
  KMAT=150.0
*ENDIF
! conductivity, density, specific heat -- the transient needs the last two, which
! the steady body never had to set.
MP,KXX,1,1.0   $ MP,KYY,1,1.0   $ MP,KZZ,1,1.0   $ MP,DENS,1,1900 $ MP,C,1,1200
MP,KXX,2,KMAT  $ MP,KYY,2,KMAT  $ MP,KZZ,2,KMAT  $ MP,DENS,2,2500 $ MP,C,2,800
MP,KXX,3,80.0  $ MP,KYY,3,80.0  $ MP,KZZ,3,80.0  $ MP,DENS,3,2330 $ MP,C,3,700
MP,KXX,4,200.0 $ MP,KYY,4,200.0 $ MP,KZZ,4,60.0  $ MP,DENS,4,8900 $ MP,C,4,385
MP,KXX,5,150.0 $ MP,KYY,5,150.0 $ MP,KZZ,5,150.0 $ MP,DENS,5,2330 $ MP,C,5,700

ET,1,SOLID70
ESIZE,TILE_W/NDPT
Z0=0 $ Z1=Z0+T_BRD $ Z2=Z1+T_SUB $ Z3=Z2+T_PIC $ Z4=Z3+T_RDL $ Z5=Z4+T_DIE
BLOCK,0,TILE_W,0,TILE_W,Z0,Z1 $ VSEL,S,LOC,Z,(Z0+Z1)/2 $ VATT,1,,1 $ VMESH,ALL $ ALLSEL
BLOCK,0,TILE_W,0,TILE_W,Z1,Z2 $ VSEL,S,LOC,Z,(Z1+Z2)/2 $ VATT,2,,1 $ VMESH,ALL $ ALLSEL
BLOCK,0,TILE_W,0,TILE_W,Z2,Z3 $ VSEL,S,LOC,Z,(Z2+Z3)/2 $ VATT,3,,1 $ VMESH,ALL $ ALLSEL
BLOCK,0,TILE_W,0,TILE_W,Z3,Z4 $ VSEL,S,LOC,Z,(Z3+Z4)/2 $ VATT,4,,1 $ VMESH,ALL $ ALLSEL
BLOCK,0,TILE_W,0,TILE_W,Z4,Z5 $ VSEL,S,LOC,Z,(Z4+Z5)/2 $ VATT,5,,1 $ VMESH,ALL $ ALLSEL
ALLSEL $ NUMMRG,NODE,1e-6 $ NUMCMP,NODE

AHOT=(TILE_W/3)*(TILE_W/3)
APIC=TILE_W*TILE_W
HGH=FHOT*P_GPU/(AHOT*T_DIE)
HGC=(1.0-FHOT)*P_GPU/((TILE_W*TILE_W-AHOT)*T_DIE)
XA=TILE_W/3 $ XB=2*TILE_W/3
YA=TILE_W/3 $ YB=2*TILE_W/3

! monitor node: centre of the PIC layer
ZPIC=(Z2+Z3)/2
NMON=NODE(TILE_W/2,TILE_W/2,ZPIC)

ASEL,S,LOC,Z,Z5 $ SFA,ALL,,CONV,HCP,TCP $ ALLSEL
ASEL,S,LOC,Z,Z0 $ SFA,ALL,,CONV,50.0,40.0 $ ALLSEL
FINISH

/SOLU
ANTYPE,TRANS
TRNOPT,FULL
OUTRES,ALL,ALL
KBC,1

! ---- step 1: steady baseline, GPU IDLE, PIC at its link-budget power ----
TIMINT,OFF
ESEL,S,MAT,,3 $ BFE,ALL,HGEN,1,P_PIC/(APIC*T_PIC) $ ALLSEL
ESEL,S,MAT,,5 $ BFE,ALL,HGEN,1,0 $ ALLSEL
TIME,1e-6
SOLVE

! ---- step 2: GPU steps to full power; PIC unchanged ----
TIMINT,ON
AUTOTS,ON
DELTIM,1e-5,1e-7,1e-3
ESEL,S,MAT,,5 $ BFE,ALL,HGEN,1,HGC $ ALLSEL
ESEL,S,MAT,,5 $ ESEL,R,CENT,X,XA,XB $ ESEL,R,CENT,Y,YA,YB $ BFE,ALL,HGEN,1,HGH $ ALLSEL
TIME,TEND
SOLVE
FINISH
