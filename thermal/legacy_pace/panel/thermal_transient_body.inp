! ==========================================================================
! thermal_transient_body.inp -- Glass-photonic FB package: TRANSIENT thermal
! Shows the stack's thermal low-pass: a GPU power STEP (idle->TDP) and the PIC
! temperature response.  glass (MATFLAG=1) vs silicon interposer (MATFLAG=0).
! Same stack/params as thermal_body.inp, plus:
!   PIDLE_W   GPU idle power [W]   (step goes PIDLE_W -> PGPU_W at t=0)
!   TEND_S    transient end time [s]
!   DT_S      time step [s]
!   CSVOUT    time-series csv (appended: tag,time,T_pic_center)
! NOTE: no /CLEAR (fresh process; /CLEAR would wipe the wrapper's *SET params).
! ==========================================================================
/PREP7

W=28.3e-3 $ ND=20
T_BRD=1.0e-3 $ T_SUB=0.7e-3 $ T_PIC=0.05e-3 $ T_RDL=0.1e-3 $ T_DIE=0.75e-3
DVIA=100e-6 $ KCU=400.0
*IF,MATFLAG,EQ,1,THEN
  KMAT=1.2
*ELSE
  KMAT=150.0
*ENDIF
FVIA=0.7853982*DVIA**2/(PITCH_UM*1e-6)**2
*IF,FVIA,GT,0.5,THEN
  FVIA=0.5
*ENDIF
KSUB_Z=KMAT*(1.0-FVIA)+KCU*FVIA $ KSUB_L=KMAT

MP,KXX,1,1.0 $ MP,KYY,1,1.0 $ MP,KZZ,1,1.0 $ MP,DENS,1,1900 $ MP,C,1,1100
MP,KXX,2,KSUB_L $ MP,KYY,2,KSUB_L $ MP,KZZ,2,KSUB_Z $ MP,DENS,2,2230 $ MP,C,2,830
MP,KXX,3,80.0 $ MP,KYY,3,80.0 $ MP,KZZ,3,80.0 $ MP,DENS,3,2300 $ MP,C,3,700
MP,KXX,4,200.0 $ MP,KYY,4,200.0 $ MP,KZZ,4,60.0 $ MP,DENS,4,2500 $ MP,C,4,800
MP,KXX,5,150.0 $ MP,KYY,5,150.0 $ MP,KZZ,5,150.0 $ MP,DENS,5,2330 $ MP,C,5,700

ET,1,SOLID70
ESIZE,W/ND
Z0=0 $ Z1=Z0+T_BRD $ Z2=Z1+T_SUB $ Z3=Z2+T_PIC $ Z4=Z3+T_RDL $ Z5=Z4+T_DIE
BLOCK,0,W,0,W,Z0,Z1 $ VSEL,S,LOC,Z,(Z0+Z1)/2 $ VATT,1,,1 $ VMESH,ALL $ ALLSEL
BLOCK,0,W,0,W,Z1,Z2 $ VSEL,S,LOC,Z,(Z1+Z2)/2 $ VATT,2,,1 $ VMESH,ALL $ ALLSEL
BLOCK,0,W,0,W,Z2,Z3 $ VSEL,S,LOC,Z,(Z2+Z3)/2 $ VATT,3,,1 $ VMESH,ALL $ ALLSEL
BLOCK,0,W,0,W,Z3,Z4 $ VSEL,S,LOC,Z,(Z3+Z4)/2 $ VATT,4,,1 $ VMESH,ALL $ ALLSEL
BLOCK,0,W,0,W,Z4,Z5 $ VSEL,S,LOC,Z,(Z4+Z5)/2 $ VATT,5,,1 $ VMESH,ALL $ ALLSEL
ALLSEL $ NUMMRG,NODE,1e-6 $ NUMCMP,NODE

VOL_DIE=W*W*T_DIE $ VOL_PIC=W*W*T_PIC
HG_PIC=PPIC_W/VOL_PIC
ESEL,S,MAT,,3 $ BFE,ALL,HGEN,1,HG_PIC $ ALLSEL       ! PIC steady
ASEL,S,LOC,Z,Z5 $ SFA,ALL,,CONV,HCP,TCP_C $ ALLSEL
ASEL,S,LOC,Z,Z0 $ SFA,ALL,,CONV,50.0,40.0 $ ALLSEL

! monitor node: PIC layer center (x=W/2,y=W/2,z=(Z2+Z3)/2)
NPIC = NODE(W/2,W/2,(Z2+Z3)/2)
FINISH

/SOLU
ANTYPE,TRANS
TRNOPT,FULL
OUTRES,ALL,ALL                                  ! store every substep, all steps
T_STEP=1.0                                       ! step happens at t = T_STEP
T_FIN=T_STEP+TEND_S
! ---- LS1: idle STEADY state as the initial condition (no time integration) --
TIMINT,OFF
ESEL,S,MAT,,5 $ BFE,ALL,HGEN,1,PIDLE_W/VOL_DIE $ ALLSEL
TIME,T_STEP $ KBC,1 $ SOLVE
! ---- LS2: turn on time integration, STEP idle -> TDP, run transient ---------
TIMINT,ON
ESEL,S,MAT,,5 $ BFE,ALL,HGEN,1,PGPU_W/VOL_DIE $ ALLSEL
TIME,T_FIN $ KBC,1 $ AUTOTS,ON $ DELTIM,DT_S,DT_S/10,DT_S*5 $ SOLVE
FINISH

! ---- post26: PIC center temperature vs time  (step at t = T_STEP = 1 s) -----
! Dump TIME + PIC temp with PRVAR (robust; auto-sizes over all stored substeps).
! CSVOUT is passed WITHOUT extension; /OUTPUT adds .csv.  Whitespace-delimited.
/POST26
NUMVAR,200
NSOL,2,NPIC,TEMP
/OUTPUT,%CSVOUT%,csv
PRVAR,2
/OUTPUT
FINISH
