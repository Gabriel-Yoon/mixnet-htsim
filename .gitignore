# Generated by simulation runs -- never committed.
# gitignore has NO trailing-comment syntax: these three lines carried their
# explanations after the pattern, so each rule was the pattern PLUS the spaces
# and the comment text, and matched nothing. Every one of these directories was
# staged-able the whole time -- which is the rule these lines were added to
# prevent, after a  over src/clos swept a 220 MB EP=128 log directory.
# Verified with  after the change, not by reading them.
#
# per-cell run logs; an EP=128 log directory is 220 MB
src/clos/datacenter/*_logs/
# one stdout log per rung job
src/clos/datacenter/rung_logs/
# calibration cell logs
src/clos/datacenter/calib_logs/
