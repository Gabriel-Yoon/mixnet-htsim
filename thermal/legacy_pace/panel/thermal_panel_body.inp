! ==========================================================================
! thermal_panel_body.inp -- FULL 4x4 glass PANEL (16 GPU tiles) 3D thermal.
! Package-scale gradient + per-tile temperatures.  Continuous layer stack
! (board / substrate / PIC / RDL / die); each tile gets die power + a central
! compute hotspot; inter-tile gaps carry no die heat.  Shared cold plate on top.
! Params (wrapper *SET): MATFLAG(1 glass/0 Si), NX(tiles/side), P_GPU(W/tile),
!   FHOT, NDPT(lateral elems per tile), TCP_C, HCP, CSVPLANE(PIC top-view csv),
!   CSVTILE(per-tile summary csv).
! No /CLEAR (fresh process; would wipe wrapper params).
! ==========================================================================
/PREP7
TILE_W=28.3e-3 $ GAP=2.0e-3 $ PT=TILE_W+GAP
PANEL=NX*PT
T_BRD=0.5e-3 $ T_SUB=0.7e-3 $ T_PIC=0.05e-3 $ T_RDL=0.1e-3 $ T_DIE=0.75e-3

*IF,MATFLAG,EQ,1,THEN
  KMAT=1.2
*ELSE
  KMAT=150.0
*ENDIF
MP,KXX,1,1.0 $ MP,KYY,1,1.0 $ MP,KZZ,1,1.0
MP,KXX,2,KMAT $ MP,KYY,2,KMAT $ MP,KZZ,2,KMAT
MP,KXX,3,80.0 $ MP,KYY,3,80.0 $ MP,KZZ,3,80.0
MP,KXX,4,200.0 $ MP,KYY,4,200.0 $ MP,KZZ,4,60.0
MP,KXX,5,150.0 $ MP,KYY,5,150.0 $ MP,KZZ,5,150.0

ET,1,SOLID70
ESIZE,PT/NDPT                    ! lateral element size = tile pitch / NDPT
Z0=0 $ Z1=Z0+T_BRD $ Z2=Z1+T_SUB $ Z3=Z2+T_PIC $ Z4=Z3+T_RDL $ Z5=Z4+T_DIE
BLOCK,0,PANEL,0,PANEL,Z0,Z1 $ VSEL,S,LOC,Z,(Z0+Z1)/2 $ VATT,1,,1 $ VMESH,ALL $ ALLSEL
BLOCK,0,PANEL,0,PANEL,Z1,Z2 $ VSEL,S,LOC,Z,(Z1+Z2)/2 $ VATT,2,,1 $ VMESH,ALL $ ALLSEL
BLOCK,0,PANEL,0,PANEL,Z2,Z3 $ VSEL,S,LOC,Z,(Z2+Z3)/2 $ VATT,3,,1 $ VMESH,ALL $ ALLSEL
BLOCK,0,PANEL,0,PANEL,Z3,Z4 $ VSEL,S,LOC,Z,(Z3+Z4)/2 $ VATT,4,,1 $ VMESH,ALL $ ALLSEL
BLOCK,0,PANEL,0,PANEL,Z4,Z5 $ VSEL,S,LOC,Z,(Z4+Z5)/2 $ VATT,5,,1 $ VMESH,ALL $ ALLSEL
ALLSEL $ NUMMRG,NODE,1e-6 $ NUMCMP,NODE

! ---- per-tile die heat generation (uniform + central hotspot) --------------
AHOT=(TILE_W/3)*(TILE_W/3)
HGH=FHOT*P_GPU/(AHOT*T_DIE)
HGC=(1.0-FHOT)*P_GPU/((TILE_W*TILE_W-AHOT)*T_DIE)
*DO,TI,0,NX-1
  *DO,TJ,0,NX-1
    X0=TI*PT $ X1=X0+TILE_W
    Y0=TJ*PT $ Y1=Y0+TILE_W
    ! tile die (cold background)
    ESEL,S,MAT,,5 $ ESEL,R,CENT,X,X0,X1 $ ESEL,R,CENT,Y,Y0,Y1
    BFE,ALL,HGEN,1,HGC $ ALLSEL
    ! central hotspot
    XA=X0+TILE_W/3 $ XB=X0+2*TILE_W/3
    YA=Y0+TILE_W/3 $ YB=Y0+2*TILE_W/3
    ESEL,S,MAT,,5 $ ESEL,R,CENT,X,XA,XB $ ESEL,R,CENT,Y,YA,YB
    BFE,ALL,HGEN,1,HGH $ ALLSEL
  *ENDDO
*ENDDO

! ---- BC: cold plate with a COOLANT GRADIENT along x (inlet cold -> outlet warm).
! Real panel gradient comes from the coolant absorbing panel heat as it flows across:
! Tcp(x) rises linearly from TCP_IN to TCP_IN+TCP_RISE.  Table vs X.
*DIM,TCPTAB,TABLE,2,1,1,X
TCPTAB(1,0,1)=0.0
TCPTAB(2,0,1)=PANEL
TCPTAB(1,1,1)=TCP_IN
TCPTAB(2,1,1)=TCP_IN+TCP_RISE
ASEL,S,LOC,Z,Z5 $ SFA,ALL,,CONV,HCP,%TCPTAB% $ ALLSEL
ASEL,S,LOC,Z,Z0 $ SFA,ALL,,CONV,50.0,40.0 $ ALLSEL

FINISH
/SOLU
ANTYPE,STATIC
SOLVE
FINISH

/POST1
SET,LAST
! ---- export PIC-layer top-view plane (X,Y,TEMP) for the panel heatmap ------
ZPIC=(Z2+Z3)/2 $ TOLZ=T_PIC/2
NSEL,S,LOC,Z,ZPIC-TOLZ,ZPIC+TOLZ
*GET,NUMMAX,NODE,,NUM,MAX
*DIM,XX,ARRAY,NUMMAX
*DIM,YY,ARRAY,NUMMAX
*DIM,TT,ARRAY,NUMMAX
*DIM,SS,ARRAY,NUMMAX
*VGET,XX(1),NODE,1,LOC,X
*VGET,YY(1),NODE,1,LOC,Y
*VGET,TT(1),NODE,1,TEMP
*VGET,SS(1),NODE,1,NSEL
*CFOPEN,%CSVPLANE%,csv
*VMASK,SS(1)
*VWRITE,XX(1),YY(1),TT(1)
(E14.7,',',E14.7,',',F10.4)
*CFCLOS
ALLSEL

! ---- per-tile summary: PIC peak/min + die peak ----------------------------
*CFOPEN,%CSVTILE%,csv
*DO,TI,0,NX-1
  *DO,TJ,0,NX-1
    X0=TI*PT $ X1=X0+TILE_W $ Y0=TJ*PT $ Y1=Y0+TILE_W
    ESEL,S,MAT,,3 $ ESEL,R,CENT,X,X0,X1 $ ESEL,R,CENT,Y,Y0,Y1 $ NSLE,S $ NSORT,TEMP
    *GET,PMAX,SORT,,MAX $ *GET,PMIN,SORT,,MIN
    ALLSEL
    ESEL,S,MAT,,5 $ ESEL,R,CENT,X,X0,X1 $ ESEL,R,CENT,Y,Y0,Y1 $ NSLE,S $ NSORT,TEMP
    *GET,DMAX,SORT,,MAX
    ALLSEL
    *VWRITE,TI,TJ,PMAX,PMIN,PMAX-PMIN,DMAX
(F4.0,',',F4.0,',',F10.3,',',F10.3,',',F10.3,',',F10.3)
  *ENDDO
*ENDDO
*CFCLOS
FINISH
