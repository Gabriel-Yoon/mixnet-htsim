! ==========================================================================
! thermal_heatmap3d_body.inp -- single-ring heater local model, export the FULL
! 3D nodal temperature field (X,Y,Z,TEMP) for a 3D heatmap / isosurface.
! glass (MATFLAG=1) vs Si (0).  Params: MATFLAG, PHEAT_W, T_REF, HCP, HEATCSV.
! No /CLEAR (fresh process; would wipe wrapper params).
! ==========================================================================
/PREP7
LL   = 0.8e-3
ND   = 32
T_BRD=0.3e-3 $ T_SUB=0.4e-3 $ T_PIC=0.05e-3 $ T_RDL=0.1e-3 $ T_DIE=0.3e-3
HW   = 25e-6

*IF,MATFLAG,EQ,1,THEN
  KMAT=1.2
*ELSE
  KMAT=150.0
*ENDIF
MP,KXX,1,1.0 $ MP,KYY,1,1.0 $ MP,KZZ,1,1.0
MP,KXX,2,KMAT $ MP,KYY,2,KMAT $ MP,KZZ,2,KMAT
MP,KXX,3,80.0 $ MP,KYY,3,80.0 $ MP,KZZ,3,80.0
MP,KXX,4,200.0 $ MP,KYY,4,200.0 $ MP,KZZ,4,60.0
MP,KXX,5,150.0 $ MP,KYY,5,150.0 $ MP,KZZ,5,150.0

ET,1,SOLID70
ESIZE,LL/ND
Z0=0 $ Z1=Z0+T_BRD $ Z2=Z1+T_SUB $ Z3=Z2+T_PIC $ Z4=Z3+T_RDL $ Z5=Z4+T_DIE
BLOCK,0,LL,0,LL,Z0,Z1 $ VSEL,S,LOC,Z,(Z0+Z1)/2 $ VATT,1,,1 $ VMESH,ALL $ ALLSEL
BLOCK,0,LL,0,LL,Z1,Z2 $ VSEL,S,LOC,Z,(Z1+Z2)/2 $ VATT,2,,1 $ VMESH,ALL $ ALLSEL
BLOCK,0,LL,0,LL,Z2,Z3 $ VSEL,S,LOC,Z,(Z2+Z3)/2 $ VATT,3,,1 $ VMESH,ALL $ ALLSEL
BLOCK,0,LL,0,LL,Z3,Z4 $ VSEL,S,LOC,Z,(Z3+Z4)/2 $ VATT,4,,1 $ VMESH,ALL $ ALLSEL
BLOCK,0,LL,0,LL,Z4,Z5 $ VSEL,S,LOC,Z,(Z4+Z5)/2 $ VATT,5,,1 $ VMESH,ALL $ ALLSEL
ALLSEL $ NUMMRG,NODE,1e-6 $ NUMCMP,NODE

XC=LL/2 $ YC=LL/2
VOL_H=(2*HW)*(2*HW)*T_PIC
HG_H=PHEAT_W/VOL_H
ESEL,S,MAT,,3 $ ESEL,R,CENT,X,XC-HW,XC+HW $ ESEL,R,CENT,Y,YC-HW,YC+HW
BFE,ALL,HGEN,1,HG_H $ ALLSEL

ASEL,S,LOC,Z,Z5 $ SFA,ALL,,CONV,HCP,T_REF $ ALLSEL
ASEL,S,LOC,Z,Z0 $ DA,ALL,TEMP,T_REF $ ALLSEL
ASEL,S,LOC,X,0 $ DA,ALL,TEMP,T_REF $ ALLSEL
ASEL,S,LOC,X,LL $ DA,ALL,TEMP,T_REF $ ALLSEL
ASEL,S,LOC,Y,0 $ DA,ALL,TEMP,T_REF $ ALLSEL
ASEL,S,LOC,Y,LL $ DA,ALL,TEMP,T_REF $ ALLSEL
ALLSEL

FINISH
/SOLU
ANTYPE,STATIC
SOLVE
FINISH

! ---- export FULL 3D field: X, Y, Z, TEMP for every node -------------------
/POST1
SET,LAST
ALLSEL
*GET,NUMMAX,NODE,,NUM,MAX
*DIM,XX,ARRAY,NUMMAX
*DIM,YY,ARRAY,NUMMAX
*DIM,ZZ,ARRAY,NUMMAX
*DIM,TT,ARRAY,NUMMAX
*DIM,SS,ARRAY,NUMMAX
*VGET,XX(1),NODE,1,LOC,X
*VGET,YY(1),NODE,1,LOC,Y
*VGET,ZZ(1),NODE,1,LOC,Z
*VGET,TT(1),NODE,1,TEMP
*VGET,SS(1),NODE,1,NSEL
*CFOPEN,%HEATCSV%,csv
*VMASK,SS(1)
*VWRITE,XX(1),YY(1),ZZ(1),TT(1)
(E14.7,',',E14.7,',',E14.7,',',F10.4)
*CFCLOS
FINISH
